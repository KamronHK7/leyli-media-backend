# Bu fayl faqat o'zgaruvchi nomlari uchun namuna. Haqiqiy qiymatlarni Render -> Environment ga kiriting.

# --- Baza ---
DATABASE_URL=

# --- Telegram ---
BOT_TOKEN=
# Premium kanal ID (masalan -100xxxxxxxxxx). Bot shu kanalda admin bo'lishi kerak
CHANNEL_ID=
# Kanal egasining Telegram ID. Botga to'lovchi User ID yozsa, havola ketadi
OWNER_TELEGRAM_ID=
# Qo'shimcha adminlar (vergul bilan), xuddi shu huquq
ADMIN_TELEGRAM_IDS=
# Ixtiyoriy: "Yordam" tugmasi uchun havola (https://t.me/... yoki https://wa.me/...)
SUPPORT_URL=
BOT_USERNAME=LeyliMedia_bot
INSTAGRAM_URL=
YOUTUBE_URL=

# --- Server ---
# Render o'zi RENDER_EXTERNAL_URL beradi. Boshqa joyda https://sizning-domen
PUBLIC_URL=
# Ixtiyoriy: webhook maxfiy so'zi (bo'sh bo'lsa BOT_TOKEN dan hosil qilinadi)
TELEGRAM_WEBHOOK_SECRET=
# /cron/expire?secret=... uchun (tashqi cron servis chaqiradi)
CRON_SECRET=

# --- Payme ---
PAYME_LOGIN=Paycom
# Ishlab chiqarish kaliti (PROD_KEY)
PAYME_KEY=
# Payme pesochitsa (test.paycom.uz) kaliti. Checkout PROD_KEY da qoladi
PAYME_TEST_KEY=
# Payme kabinetidagi kassa (Merchant) ID
PAYME_MERCHANT_ID=
# true — sandbox kaliti. Checkout test.paycom.uz da. Production kassa yoqilgach: production
PAYME_TEST_MODE=false
# true yoki PAYME_TEST_MODE=production bo'lsa checkout.paycom.uz
PAYME_USE_PROD_CHECKOUT=false
# Faqat sandbox testi uchun, masalan 12345. Sandbox tugagach o'chiring
PAYME_TEST_USER_ID=
